{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "catalogo.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/proposta.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)\\.(png|jpg|jpeg|webp|gif|svg|ico|mp4|webm|woff2?)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)\\.(js|css)$",
      "headers": {
        "Cache-Control": "public, max-age=604800, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/catalogo\\.pdf",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate",
        "Content-Disposition": "inline; filename=\"catalogo-fw-digital.pdf\""
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)\\.(js|mjs|css|png|jpg|jpeg|webp|gif|svg|ico|mp4|webm|woff2?|json|txt|xml|map|pdf)$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
