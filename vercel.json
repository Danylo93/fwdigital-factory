{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)\\.(js|mjs|css|png|jpg|jpeg|webp|gif|svg|ico|mp4|webm|woff2?|json|txt|map)$", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
