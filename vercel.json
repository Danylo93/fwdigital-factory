{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/assets/(.*)\\.(png|jpg|jpeg|webp|gif|svg|ico|mp4|webm|woff2?)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/assets/(.*)\\.(js|css)$",
      "headers": { "Cache-Control": "public, max-age=604800, must-revalidate" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)\\.(js|mjs|css|png|jpg|jpeg|webp|gif|svg|ico|mp4|webm|woff2?|json|txt|xml|map)$",
      "status": 404
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
